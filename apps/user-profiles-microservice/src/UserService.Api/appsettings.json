{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "Subscribe": {
      "InitialDelay": "00:00:02",
      "MaxDelay": "00:00:30"
    },
    "Handler": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:01"
    },
    "Publish": {
      "Timeout": "00:00:05",
      "FailureRatio": 0.5,
      "MinimumThroughput": 5,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:15"
    }
  }
}
